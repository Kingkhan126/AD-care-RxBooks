generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OrganizationSettings {
  id              String   @id @default("org_main")
  name            String
  legalName       String
  tagline         String
  taxId           String
  email           String
  phone           String
  website         String
  currency        String
  fiscalYearStart String
  address         String
  city            String
  country         String
  updatedAt       DateTime @updatedAt
}

model Contact {
  id          String   @id @default(uuid())
  name        String
  companyName String
  type        String   // 'customer' | 'vendor'
  email       String
  phone       String
  address     String
  city        String
  country     String
  receivables Float    @default(0.0)
  payables    Float    @default(0.0)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Item {
  id           String   @id @default(uuid())
  name         String
  sku          String   @unique
  type         String   // 'product' | 'service'
  unit         String
  salesPrice   Float
  costPrice    Float
  taxRate      Float    @default(0.0)
  stockOnHand  Int      @default(0)
  reorderPoint Int      @default(0)
  description  String
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Warehouse {
  id         String   @id @default(uuid())
  name       String
  code       String   @unique
  location   String
  isPrimary  Boolean  @default(false)
  totalStock Int      @default(0)
  createdAt  DateTime @default(now())
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  customerId    String
  customerName  String
  customerEmail String
  issueDate     String
  dueDate       String
  subtotal      Float
  taxTotal      Float         @default(0.0)
  discountTotal Float         @default(0.0)
  shippingTotal Float         @default(0.0)
  totalAmount   Float
  amountPaid    Float         @default(0.0)
  balanceDue    Float
  status        String        @default("sent")
  notes         String
  terms         String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         InvoiceItem[]
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId      String
  itemName    String
  description String
  quantity    Float
  unitPrice   Float
  taxRate     Float   @default(0.0)
  amount      Float
}

model Bill {
  id            String     @id @default(uuid())
  billNumber    String     @unique
  vendorId      String
  vendorName    String
  issueDate     String
  dueDate       String
  subtotal      Float
  taxTotal      Float      @default(0.0)
  discountTotal Float      @default(0.0)
  shippingTotal Float      @default(0.0)
  totalAmount   Float
  amountPaid    Float      @default(0.0)
  balanceDue    Float
  status        String     @default("received")
  notes         String
  terms         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  items         BillItem[]
}

model BillItem {
  id          String @id @default(uuid())
  billId      String
  bill        Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  itemId      String
  itemName    String
  description String
  quantity    Float
  unitPrice   Float
  taxRate     Float  @default(0.0)
  amount      Float
}

model Expense {
  id            String   @id @default(uuid())
  expenseNumber String   @unique
  category      String
  amount        Float
  taxAmount     Float    @default(0.0)
  date          String
  vendorId      String?
  vendorName    String?
  paymentMode   String
  account       String
  description   String
  receiptUrl    String?
  createdAt     DateTime @default(now())
}

model BankAccount {
  id                 String   @id @default(uuid())
  accountName        String
  accountNumber      String
  bankName           String
  accountType        String
  currency           String   @default("PKR")
  balance            Float    @default(0.0)
  lastReconciledDate String
  status             String   @default("connected")
  createdAt          DateTime @default(now())
}

model BankTransaction {
  id            String   @id @default(uuid())
  bankAccountId String
  date          String
  description   String
  amount        Float
  category      String
  reference     String
  isMatched     Boolean  @default(false)
  matchedId     String?
  matchedType   String?
  createdAt     DateTime @default(now())
}

model Account {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  category    String   // 'asset' | 'liability' | 'equity' | 'income' | 'expense'
  type        String
  balance     Float    @default(0.0)
  description String
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model JournalEntry {
  id          String             @id @default(uuid())
  entryNumber String             @unique
  date        String
  reference   String
  narration   String
  totalDebit  Float
  totalCredit Float
  status      String             @default("posted")
  createdAt   DateTime           @default(now())
  lines       JournalEntryLine[]
}

model JournalEntryLine {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  accountCode    String
  accountName    String
  debit          Float        @default(0.0)
  credit         Float        @default(0.0)
  memo           String
}

model AuditLog {
  id        String   @id @default(uuid())
  timestamp String
  userName  String
  action    String
  module    String
  details   String
  ipAddress String
  createdAt DateTime @default(now())
}
